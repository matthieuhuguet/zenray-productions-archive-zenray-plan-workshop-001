import '@testing-library/jest-dom/vitest'

class ResizeObserverStub {
  observe() {}
  unobserve() {}
  disconnect() {}
}

if (!globalThis.ResizeObserver) globalThis.ResizeObserver = ResizeObserverStub

class MemoryStorage {
  #data = new Map()
  get length() { return this.#data.size }
  clear() { this.#data.clear() }
  getItem(key) { return this.#data.has(String(key)) ? this.#data.get(String(key)) : null }
  key(index) { return [...this.#data.keys()][index] ?? null }
  removeItem(key) { this.#data.delete(String(key)) }
  setItem(key, value) { this.#data.set(String(key), String(value)) }
}

// Node 22 exposes an experimental localStorage getter which can resolve to
// undefined without --localstorage-file and shadow jsdom's implementation.
if (!globalThis.localStorage) Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: new MemoryStorage() })
if (!globalThis.sessionStorage) Object.defineProperty(globalThis, 'sessionStorage', { configurable: true, value: new MemoryStorage() })
