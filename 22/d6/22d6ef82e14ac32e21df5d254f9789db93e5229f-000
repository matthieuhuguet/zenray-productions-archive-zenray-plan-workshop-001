// RÉGRESSION (bug réel signalé par Matthieu le 2026-07-25) : le format A4 était inutilisable —
// le compilateur ignorait le `dpi`, donc un corps de 19 px atterrissait sur un canevas de
// 2480 px de large. Ce bloc vérifie TOUS les formats, pas seulement celui qu'on a sous les yeux.
describe('L5/L6 — tout format produit un rendu lisible', () => {
  const bodySizeOf = (html) => {
    const body = /body\{[^}]*?font-size:([\d.]+)px/.exec(html)
    return body ? Number(body[1]) : null
  }

  for (const format of FORMATS) {
    it(`${format.label} : corps proportionné au canevas`, () => {
      const { brief, cut } = fixture()
      const { html } = compile({ brief, cut, theme, format, seed: 1 })
      const size = bodySizeOf(html)
      expect(size).toBeGreaterThan(0)
      if (format.canvas.h > 0) {
        // Plancher de lisibilité : sous ~1,2 % de la largeur du canevas, le texte devient un
        // timbre-poste. C'est exactement ce que produisait A4 avant le correctif (0,77 %).
        expect(size / format.canvas.w).toBeGreaterThan(0.012)
        // LE PLAFOND DÉPEND DE LA LARGEUR, et ce n'est pas une concession (2026-08-04).
        //
        // Six pour cent était calibré sur des canevas de mille pixels et plus. Sur un pavé
        // publicitaire de 320 px, un corps de 20 px pèse 6,4 % de la largeur et reste parfaitement
        // juste : c'est la taille qu'on lit sur une bannière mobile. Un rapport n'est pas une
        // constante universelle, il dépend de la distance de lecture, laquelle dépend de la taille
        // de la boîte. Le plafond s'assouplit donc sous 600 px, et nulle part ailleurs.
        const plafond = format.canvas.w < 600 ? 0.11 : 0.06
        expect(size / format.canvas.w).toBeLessThan(plafond) // ni l'inverse : pas d'affiche de 2 mots
      } else {
        expect(size).toBeGreaterThanOrEqual(16) // confort de lecture à l'écran
      }
    })

    it(`${format.label} : bloc centré, texte ferré à gauche, mesure bornée`, () => {
      const { brief, cut } = fixture()
      const { html } = compile({ brief, cut, theme, format, seed: 1 })
      expect(html).toContain('class="zrm-frame"')
      expect(html).toContain('class="zrm-page"')
      expect(/\.zrm-page\{[^}]*margin:0 auto/.test(html)).toBe(true)   // bloc centré
      expect(/\.zrm-page\{[^}]*text-align:left/.test(html)).toBe(true) // texte à gauche
      const maxWidth = /\.zrm-page\{[^}]*max-width:([^;]+);/.exec(html)
      expect(maxWidth).toBeTruthy()
      if (format.canvas.h > 0) expect(maxWidth[1]).toContain('ch') // mesure de lecture réelle
    })
  }

  it('A4 rend un corps d’environ 14 points réels à 300 dpi', () => {
    const { brief, cut } = fixture()
    const a4 = getFormat('F-print-a4')
    const { html } = compile({ brief, cut, theme, format: a4, seed: 1 })
    const px = bodySizeOf(html)
    const points = (px / a4.canvas.dpi) * 72
    expect(points).toBeGreaterThan(10)
    expect(points).toBeLessThan(20)
  })
})

// RÉGRESSION (2026-07-25) : « énormément de bugs sur tous les formats crop ». La cause n'était
// pas le rendu mais la doctrine — on tentait de faire rentrer un article de 5 blocs sur un carré
// 1080. Un format décide désormais de ce qu'il montre, et l'échelle se MESURE au lieu de se deviner.
describe('L5/L6 — politique de contenu et ajustement', () => {
  it('un format de lecture montre tout, un format d’image montre l’essentiel', () => {
    const { cut } = fixture()
    expect(cut.beats.length).toBeGreaterThan(2)
    expect(visibleBeats(cut, getFormat('F-web-article')).length).toBe(cut.beats.length)
    expect(visibleBeats(cut, getFormat('F-print-a4')).length).toBe(cut.beats.length)
    expect(visibleBeats(cut, getFormat('F-still-1080-square')).length).toBe(1)
    expect(visibleBeats(cut, getFormat('F-still-1080x1920')).length).toBe(2)
  })

  it('ce qui n’est pas montré est COMPTÉ, jamais perdu en silence', () => {
    const { brief, cut } = fixture()
    const square = getFormat('F-still-1080-square')
    expect(omittedCount(cut, square)).toBe(cut.beats.length - 1)
    expect(omittedCount(cut, getFormat('F-web-article'))).toBe(0)
    const { meta } = compile({ brief, cut, theme, format: square, seed: 1 })
    expect(meta.shown + meta.omitted).toBe(cut.beats.length)
  })

  it('le Critique annonce les blocs réservés aux formats de lecture', () => {
    const { brief, cut } = fixture()
    const issues = inspectStatic({ brief, cut, theme, format: getFormat('F-still-1080-square') })
    const note = issues.find((i) => i.code === 'fit.omitted')
    expect(note).toBeTruthy()
    expect(note.severity).toBe(SEVERITY.info)   // une information, pas un blocage : c'est voulu
    expect(summarize(issues).canPublish).toBe(true)
  })

  it('l’échelle mesurée descend palier par palier et s’arrête au plancher', () => {
    let scale = 1
    const seen = [scale]
    for (let i = 0; i < 12; i++) { scale = nextShrink(scale); seen.push(scale) }
    // Strictement décroissante jusqu'au plancher, puis stable : jamais de boucle infinie.
    expect(scale).toBe(MIN_SHRINK)
    expect(nextShrink(MIN_SHRINK)).toBe(MIN_SHRINK)
    expect(seen[1]).toBeLessThan(1)
    expect(new Set(seen).size).toBeGreaterThan(3)
  })

  it('une échelle imposée par la mesure gagne sur l’estimation', () => {
    const { brief, cut } = fixture()
    const square = getFormat('F-still-1080-square')
    const guessed = compile({ brief, cut, theme, format: square, seed: 1 })
    const measured = compile({ brief, cut, theme, format: square, seed: 1, fitScale: 0.54 })
    expect(measured.meta.scale).toBe(0.54)
    expect(measured.meta.scale).toBeLessThanOrEqual(guessed.meta.scale)
    // Et l'export utilisera la MÊME valeur que l'aperçu : la page compilée en porte la trace.
    expect(measured.html).toContain('data-zrm-scale="0.54"')
  })

  it('le titre domine sur une affiche, pas sur un article', () => {
    const { brief, cut } = fixture()
    const titleOf = (html) => Number(/\.zrm-title\{[^}]*?font-size:([\d.]+)px/.exec(html)?.[1])
    const bodyOf = (html) => Number(/body\{[^}]*?font-size:([\d.]+)px/.exec(html)?.[1])
    const article = compile({ brief, cut, theme, format: getFormat('F-web-article'), seed: 1 }).html
    const poster = compile({ brief, cut, theme, format: getFormat('F-still-1080-square'), seed: 1 }).html
    expect(titleOf(poster) / bodyOf(poster)).toBeGreaterThan(titleOf(article) / bodyOf(article))
  })
})

describe('Gabarits HTML déposés à la main', () => {
  it('remplace les champs et répète les beats', () => {
    const tpl = '<h1>{{title}}</h1>{{#beats}}<p data-r="{{role}}">{{number}}. {{text}}</p>{{/beats}}{{^beats}}<em>vide</em>{{/beats}}'
    const out = renderTemplate(tpl, { title: 'Titre', beats: [{ role: 'hook', text: 'Un' }, { role: 'cta', text: 'Deux' }] })
    expect(out).toBe('<h1>Titre</h1><p data-r="hook">1. Un</p><p data-r="cta">2. Deux</p>')
    expect(renderTemplate(tpl, { title: 'T', beats: [] })).toBe('<h1>T</h1><em>vide</em>')
  })

  it('échappe par défaut et laisse passer le brut sur trois accolades', () => {
    expect(renderTemplate('{{a}}', { a: '<b>x</b>' })).toBe('&lt;b&gt;x&lt;/b&gt;')
    expect(renderTemplate('{{{a}}}', { a: '<b>x</b>' })).toBe('<b>x</b>')
    expect(escapeHtml(`<"'&>`)).toBe('&lt;&quot;&#39;&amp;&gt;')
  })

  it('signale un gabarit qui n’utilise ni titre ni beats', () => {
    expect(inspectTemplate('<p>rien</p>')).toEqual({ usesTitle: false, usesBeats: false, hasHtmlSkeleton: false })
    expect(inspectTemplate('<html><h1>{{title}}</h1>{{#beats}}x{{/beats}}</html>').usesBeats).toBe(true)
  })

  it('un gabarit malformé ne boucle jamais à l’infini', () => {
    expect(() => renderTemplate('{{#beats}}sans fin', { beats: [1] })).not.toThrow()
  })

  it('lit l’en-tête déclaratif d’un gabarit, et survit à un en-tête cassé', () => {
    const good = '<!--zr-theme { "description": "Une nationale", "formats": ["F-web-article","F-print-a4"], "beatCount": {"min":4,"max":12}, "measure": 64 } -->\n<html>…'
    expect(readThemeHeader(good)).toMatchObject({ description: 'Une nationale', measure: 64 })
    expect(readThemeHeader(good).formats).toEqual(['F-web-article', 'F-print-a4'])
    // Absent, cassé ou hostile : le gabarit reste utilisable, jamais d'exception.
    expect(readThemeHeader('<html>rien</html>')).toEqual({})
    expect(readThemeHeader('<!--zr-theme { casse: }-->')).toEqual({})
    expect(readThemeHeader('<!--zr-theme [1,2,3]-->')).toEqual({})
    expect(readThemeHeader(null)).toEqual({})
  })

  it('lit les métadonnées depuis le nom de fichier', () => {
    expect(parseThemeFileName('./T-01-3-2--lecture-pure.html')).toMatchObject({ id: 'T-01-3-2', family: '01', sub: 3, variant: 2, name: 'Lecture pure' })
    expect(parseThemeFileName('./mauvais-nom.html')).toBe(null)
    expect(parseThemeId('T-16-8-1').familyLabel).toBe('Japon & Asie')
  })
})

describe('L4 — registre de polices (ZM-L4-11)', () => {
  it('installe les six archétypes typographiques, tous sous licence libre', () => {
    expect(FONTS.length).toBeGreaterThanOrEqual(13)
    for (const a of ['labeur', 'grotesque', 'condense', 'didone', 'mono']) {
      expect(fontsOfArchetype(a).length).toBeGreaterThan(0)
    }
    // Embarquer une police dans un fichier livré au client EXIGE une licence qui l'autorise.
    for (const f of FONTS) expect(['OFL-1.1', 'Apache-2.0']).toContain(f.license)
  })

  it('couvre les 128 sous-familles du catalogue, une police chacune', () => {
