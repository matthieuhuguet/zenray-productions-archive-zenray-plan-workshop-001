describe('L0 — contrats', () => {
  it('refuse un message à deux phrases', () => {
    const brief = { ...emptyBrief(), id: 'b', title: 'T', audience: 'A', message: 'Une phrase. Puis une autre.' }
    const errors = validate('brief', brief)
    expect(errors.some((e) => e.code === 'single-sentence')).toBe(true)
  })

  it('accepte une phrase avec des abréviations', () => {
    expect(sentenceCount('Cf. le plan, M. Dupont a raison')).toBe(1)
    expect(sentenceCount('Deux phrases. Vraiment deux.')).toBe(2)
  })

  it('refuse un job sans graine', () => {
    expect(validate('job', { cutId: 'c', themeId: 't', formatId: 'f' }).some((e) => e.field === 'seed')).toBe(true)
    expect(isValid('job', { cutId: 'c', themeId: 't', formatId: 'f', seed: 1 })).toBe(true)
  })

  it('refuse un livrable sans sonde ni empreinte', () => {
    const errors = validate('deliverable', { jobId: 'j', bytes: 10 })
    expect(errors.map((e) => e.field).sort()).toEqual(['checksum', 'probe'])
  })

  it('refuse un thème dont un champ public porte une marque', () => {
    const leaky = { ...theme, name: 'Style BFM' }
    expect(validate('theme', leaky).some((e) => e.code === 'trademark')).toBe(true)
  })

  it('rng est déterministe et makeId stable', () => {
    const a = Array.from({ length: 5 }, rng(42))
    const b = Array.from({ length: 5 }, rng(42))
    expect(a).toEqual(b)
    expect(a).not.toEqual(Array.from({ length: 5 }, rng(43)))
    expect(makeId('x', 'abc', 1)).toBe(makeId('x', 'abc', 1))
    expect(makeId('x', 'abc', 1)).not.toBe(makeId('x', 'abc', 2))
    expect(checksumOf('abc')).toBe(checksumOf('abc'))
  })
})

// AUDIT T2 · les quatre contrats que 06-BACKLOG-PRIORISE.md exige avant R3 (migrations) et V1
// (modèle Page canonique) : Document V3, Theme Package, Artifact, Publication. Écrits ici en CODE
// (schémas + validateurs + tests), pas en document séparé — cohérent avec « tu génères uniquement
// le code » et avec le validateur unique déjà en place pour les six contrats L0 ci-dessus.
describe('T2 — contrats Document V3 / Theme Package / Artifact / Publication', () => {
  it('un document complet est valide ; l’identité, la révision et l’empreinte enregistrée sont obligatoires', () => {
    const doc = { documentId: 'doc-1', schemaVersion: DOCUMENT_SCHEMA_VERSION, revisionId: 'rev-1', savedHash: 'h1' }
    expect(isValid('document', doc)).toBe(true)
    expect(validate('document', { schemaVersion: 3, revisionId: 'r', savedHash: 'h' }).some((e) => e.field === 'documentId')).toBe(true)
    expect(validate('document', { documentId: 'd', revisionId: 'r', savedHash: 'h' }).some((e) => e.field === 'schemaVersion')).toBe(true)
    expect(validate('document', { documentId: 'd', schemaVersion: 3, savedHash: 'h' }).some((e) => e.field === 'revisionId')).toBe(true)
    expect(validate('document', { documentId: 'd', schemaVersion: 3, revisionId: 'r' }).some((e) => e.field === 'savedHash')).toBe(true)
  })

  it('un chemin Create sans SHA de base est refusé : l’association appartient au document, jamais à un état global', () => {
    const doc = { documentId: 'd', schemaVersion: 3, revisionId: 'r', savedHash: 'h', createPath: 'Media/x.zmedia.json' }
    expect(validate('document', doc).some((e) => e.field === 'createSha')).toBe(true)
    expect(isValid('document', { ...doc, createSha: 'sha1' })).toBe(true)
    // Jamais enregistré dans Create : createPath/createSha absents reste un document VALIDE.
    expect(isValid('document', { documentId: 'd', schemaVersion: 3, revisionId: 'r', savedHash: 'h' })).toBe(true)
  })

  it('un paquet de thème complet est valide ; polices et droits d’usage sont obligatoires', () => {
    const pkg = { id: 'T-01-3-2', packageVersion: '1', pieces: [], props: {}, assets: [], fonts: ['Anthropic Sans'], license: 'interne', compatibleFormats: ['F-web-article'] }
    expect(isValid('themePackage', pkg)).toBe(true)
    expect(validate('themePackage', { ...pkg, fonts: [] }).some((e) => e.field === 'fonts')).toBe(true)
    expect(validate('themePackage', { ...pkg, license: '' }).some((e) => e.field === 'license')).toBe(true)
    expect(validate('themePackage', { ...pkg, id: 'pas-un-identifiant' }).some((e) => e.field === 'id')).toBe(true)
  })

  it('un artefact PNG/PDF sans dimensions réelles est refusé ; un artefact HTML n’en a pas besoin', () => {
    const base = { checksum: 'abc', bytes: 100, jobId: 'job-1' }
    expect(isValid('artifact', { ...base, kind: 'html' })).toBe(true)
    expect(validate('artifact', { ...base, kind: 'png' }).some((e) => e.field === 'dimensions')).toBe(true)
    expect(isValid('artifact', { ...base, kind: 'png', width: 800, height: 600 })).toBe(true)
    expect(validate('artifact', { kind: 'html', bytes: 100, jobId: 'job-1' }).some((e) => e.field === 'checksum')).toBe(true)
    expect(validate('artifact', { ...base, kind: 'html', jobId: undefined }).some((e) => e.field === 'jobId')).toBe(true)
  })

  it('une publication respecte ses six états ; échec et succès portent chacun leur preuve', () => {
    const base = { id: 'pub-1', documentId: 'doc-1', channel: 'create', artifactIds: [] }
    expect(isValid('publication', { ...base, status: 'brouillon' })).toBe(true)
    expect(validate('publication', { ...base, status: 'inconnu' }).some((e) => e.field === 'status')).toBe(true)
    expect(validate('publication', { ...base, status: 'prêt' }).some((e) => e.field === 'attempts')).toBe(true)
    expect(isValid('publication', { ...base, status: 'prêt', attempts: 1 })).toBe(true)
    expect(validate('publication', { ...base, status: 'échoué', attempts: 1 }).some((e) => e.field === 'error')).toBe(true)
    expect(validate('publication', { ...base, status: 'publié', attempts: 1 }).some((e) => e.field === 'receiptUrl')).toBe(true)
    expect(isValid('publication', { ...base, status: 'publié', attempts: 1, receiptUrl: 'https://…' })).toBe(true)
  })
})

describe('L3 — le Monteur', () => {
  it('respecte le nombre de beats imposé par le thème', () => {
    const { cut } = fixture()
    expect(cut.beats.length).toBeGreaterThanOrEqual(theme.beatCount.min)
    expect(cut.beats.length).toBeLessThanOrEqual(theme.beatCount.max)
    expect(isValid('cut', cut)).toBe(true)
  })

  it('ne perd jamais un mot en ajustant le nombre de beats', () => {
    const { brief } = fixture()
    const words = (t) => String(t).split(/\s+/).filter(Boolean).length
    const source = words(SEED_NOTES)
    const cut = buildCut(brief, SEED_NOTES, { beatCount: { min: 3, max: 3 } })
    expect(cut.beats.length).toBe(3)
    expect(words(cut.beats.map((b) => b.text).join(' '))).toBe(source)
  })

  it('ouvre sur une accroche et ferme sur un appel', () => {
    expect(roleForPosition(0, 5)).toBe('hook')
    expect(roleForPosition(4, 5)).toBe('cta')
    expect(roleForPosition(3, 5)).toBe('payoff')
    expect(roleForPosition(0, 1)).toBe('hook')
  })

  it('déplace, fusionne, scinde, ajoute et retire sans casser le contrat', () => {
    const { cut } = fixture()
    const moved = moveBeat(cut, 0, 2)
    expect(moved.beats[2].id).toBe(cut.beats[0].id)
    expect(isValid('cut', moved)).toBe(true)

    const merged = mergeBeats(cut, 0)
    expect(merged.beats.length).toBe(cut.beats.length - 1)
    expect(merged.beats[0].text).toContain(cut.beats[1].text.slice(0, 20))

    const split = splitBeat(cut, 1)
    expect(split.beats.length).toBeGreaterThanOrEqual(cut.beats.length)

    const added = addBeat(cut, 0)
    expect(added.beats.length).toBe(cut.beats.length + 1)
    expect(isValid('cut', added)).toBe(true)

    const removed = removeBeat(cut, 0)
    expect(removed.beats.length).toBe(cut.beats.length - 1)

    const patched = updateBeat(cut, 0, { text: 'Texte remplacé pour le test.' })
    expect(patched.beats[0].text).toBe('Texte remplacé pour le test.')
    expect(cut.beats[0].text).not.toBe('Texte remplacé pour le test.') // immuabilité
  })

  it('ne refit pas un cut verrouillé', () => {
    const { cut } = fixture()
    const locked = { ...cut, locked: true }
    expect(refitCut(locked, { beatCount: { min: 1, max: 1 } })).toBe(locked)
  })
})

