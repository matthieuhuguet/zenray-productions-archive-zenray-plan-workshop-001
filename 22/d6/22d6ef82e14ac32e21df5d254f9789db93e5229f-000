describe('L5/L9 — arbre de déclinaisons', () => {
  it('montre toutes les sorties d’un coup, groupées par intention de diffusion', () => {
    const { brief, cut } = fixture()
    const tree = declensionTree({ brief, cut, theme })
    expect(tree.map((g) => g.id)).toEqual(['lecture', 'reseaux', 'ecran'])
    const branches = tree.flatMap((g) => g.branches)
    expect(branches.length).toBe(DECLENSION_GROUPS.reduce((n, g) => n + g.formats.length, 0))
    // Chaque branche porte son ETAT REEL, pas une decoration.
    for (const b of branches) {
      expect(typeof b.ready).toBe('boolean')
      expect(b.shown + b.omitted).toBe(b.total)
      expect(b.total).toBe(cut.beats.length)
    }
  })

  it('distingue une lecture d’une image : la première montre tout, la seconde non', () => {
    const { brief, cut } = fixture()
    const tree = declensionTree({ brief, cut, theme })
    const web = tree[0].branches.find((b) => b.formatId === 'F-web-article')
    const carre = tree[1].branches.find((b) => b.formatId === 'F-still-1080-square')
    expect(web.omitted).toBe(0)
    expect(carre.omitted).toBeGreaterThan(0)
    expect(carre.shown).toBeLessThan(web.shown)
  })

  it('signale les formats que le thème ne déclare pas', () => {
    const { brief, cut } = fixture()
    const etroit = { ...theme, formats: ['F-web-article'] }
    const s = declensionSummary(declensionTree({ brief, cut, theme: etroit }))
    expect(s.undeclared).toContain('F-still-1080x1920')
    expect(s.undeclared).not.toContain('F-web-article')
  })

  it('chiffre ce qui reste hors cadre, en mots', () => {
    const { cut } = fixture()
    expect(trimAdvice(cut, webFormat)).toBe(null)
    const advice = trimAdvice(cut, getFormat('F-still-1080-square'))
    expect(advice.omitted).toBe(cut.beats.length - 1)
    expect(advice.words).toBeGreaterThan(20)   // « il te manque de la place », pas juste « ça déborde »
  })

  it('un groupe est en défaut dès qu’UNE branche l’est : on ne moyenne pas un blocage', () => {
    const { brief, cut } = fixture()
    const pale = { ...theme, palette: { ...theme.palette, ink: 'rgba(210,210,210,1)' } }
    const tree = declensionTree({ brief, cut, theme: pale })
    expect(declensionSummary(tree).blocking).toBeGreaterThan(0)
    expect(tree.every((g) => g.ready < g.total)).toBe(true)
  })
})

