// AUDIT P0-R8 · `newProject`/`duplicateProject`/`resetSeed` employaient `list.length` comme
// compteur d'identifiant. Supprimer un projet du milieu d'une liste de trois puis en créer un
// nouveau peut ramener la longueur à une valeur déjà vue, donc reproduire l'identifiant d'un
// projet ENCORE VIVANT. `nextProjectSerial` remplace ce compteur par une valeur qui ne recule
// jamais, persistée indépendamment de la liste elle-même — même principe que `composition.serial`
// pour les calques (`layers.js`), déjà éprouvé sur ce dépôt.
describe('store — identités de projet (AUDIT P0-R8)', () => {
  it('nextProjectSerial ne se répète jamais et croît strictement à chaque appel', () => {
    const a = nextProjectSerial()
    const b = nextProjectSerial()
    const c = nextProjectSerial()
    expect(b).toBeGreaterThan(a)
    expect(c).toBeGreaterThan(b)
    expect(new Set([a, b, c]).size).toBe(3)
  })

  it('un identifiant recréé après une suppression simulée ne collisionne jamais avec un survivant', () => {
    // Reproduit exactement le risque documenté : projet 1 créé, projet 2 créé puis « supprimé »
    // (retiré de la liste vivante, mais le compteur ne le sait pas et ne recule jamais), projet 3
    // créé ensuite. Avec `list.length` seul, projet 3 aurait pu reprendre le compteur du projet 2
    // pendant que celui-ci existe TOUJOURS dans une autre liste ou un autre onglet.
    const n1 = nextProjectSerial()
    const id1 = makeId('project', `nouveau${n1}`, n1)
    const n2 = nextProjectSerial()
    const id2 = makeId('project', `nouveau${n2}`, n2)   // « supprimé » ensuite, mais le compteur avance quand même
    const n3 = nextProjectSerial()
    const id3 = makeId('project', `nouveau${n3}`, n3)
    expect(id3).not.toBe(id1)
    expect(id3).not.toBe(id2)
  })
})

// AUDIT P1-R11 · le Cut porte un verrou dont seul `refitCut` respectait le sens : les neuf autres
// mutations (déplacer/fusionner/scinder/modifier/retirer/ajouter un beat, ajouter/retirer/déplacer
// un emplacement média) l'ignoraient totalement, à l'inverse de ce que le bouton promet déjà
// (« un article verrouillé ne bouge plus »). La fusion, elle, tronquait silencieusement au-delà de
// MAX_SLOTS. Et `addBeat`/`splitBeat` dérivaient leur identifiant de la position courante, qu'une
// suppression puis une insertion identique pouvait reproduire à l'identique.
describe('cut — verrou, fusion sans perte et identifiants (AUDIT P1-R11)', () => {
  it('Verrouillé bloque les neuf mutations directes, refitCut compris', () => {
    let c = fixture().cut
    c = addSlot(c, 0, { kind: 'image', dataUrl: 'data:image/png;base64,AAA', label: 'x' })
    c = { ...c, locked: true }
    const gele = c

    expect(moveBeat(c, 0, 1)).toBe(gele)
    expect(mergeBeats(c, 0)).toBe(gele)
    expect(splitBeat(c, 0)).toBe(gele)
    expect(updateBeat(c, 0, { text: 'Modifié.' })).toBe(gele)
    expect(removeBeat(c, 0)).toBe(gele)
    expect(addBeat(c, 0)).toBe(gele)
    expect(addSlot(c, 1, { kind: 'image', dataUrl: 'data:image/png;base64,BBB' })).toBe(gele)
    expect(removeSlot(c, 0, 0)).toBe(gele)
    expect(moveSlot(c, 0, 0, 0)).toBe(gele)
    expect(refitCut(c, { beatCount: { min: 1, max: 1 } })).toBe(gele)
  })

  it('une mutation directe reste possible sur un Cut NON verrouillé : le verrou est bien la seule cause du refus', () => {
    const c = fixture().cut
    expect(updateBeat(c, 0, { text: 'Modifié.' })).not.toBe(c)
  })

  it('une fusion qui dépasserait MAX_SLOTS est REFUSÉE, jamais tronquée en silence', () => {
    let c = fixture().cut
    // Trois emplacements sur le premier beat, deux sur le second : la somme (5) dépasse MAX_SLOTS (4).
    c = addSlot(c, 0, { kind: 'image', dataUrl: 'data:image/png;base64,A' })
    c = addSlot(c, 0, { kind: 'image', dataUrl: 'data:image/png;base64,B' })
    c = addSlot(c, 0, { kind: 'image', dataUrl: 'data:image/png;base64,C' })
    c = addSlot(c, 1, { kind: 'image', dataUrl: 'data:image/png;base64,D' })
    c = addSlot(c, 1, { kind: 'image', dataUrl: 'data:image/png;base64,E' })
    expect(c.beats[0].slots).toHaveLength(3)
    expect(c.beats[1].slots).toHaveLength(2)

    const avant = c
    const apres = mergeBeats(c, 0)
    expect(apres).toBe(avant)   // refusée : rien ne change
    expect(apres.beats[0].slots).toHaveLength(3)   // aucune image perdue
    expect(apres.beats[1].slots).toHaveLength(2)
  })

  it('une fusion qui reste dans la limite réussit normalement, sans régression', () => {
    let c = fixture().cut
    c = addSlot(c, 0, { kind: 'image', dataUrl: 'data:image/png;base64,A' })
    c = addSlot(c, 1, { kind: 'image', dataUrl: 'data:image/png;base64,B' })
    const apres = mergeBeats(c, 0)
    expect(apres).not.toBe(c)
    expect(apres.beats[0].slots).toHaveLength(2)
    expect(apres.beats.length).toBe(c.beats.length - 1)
  })

  it('un beat recréé au même endroit après suppression ne reprend jamais un identifiant déjà employé', () => {
    let c = fixture().cut
    const idsVus = new Set(c.beats.map((b) => b.id))

    c = addBeat(c, 1)
    const premierAjout = c.beats[2]
    expect(idsVus.has(premierAjout.id)).toBe(false)

    // Avant le correctif, `addBeat` dérivait son id de la position ET de la longueur COURANTES :
    // retirer ce beat puis reproduire EXACTEMENT le même appel (même position, même longueur de
    // tableau retrouvée) reproduisait donc EXACTEMENT le même identifiant.
    c = removeBeat(c, 2)
    c = addBeat(c, 1)
    const secondAjout = c.beats[2]
    expect(secondAjout.id).not.toBe(premierAjout.id)
    expect(idsVus.has(secondAjout.id)).toBe(false)
  })

  it('scinder un beat produit deux identifiants neufs, jamais déjà employés ni identiques entre eux', () => {
    let c = fixture().cut
    c = updateBeat(c, 0, { text: 'Première phrase ici. Deuxième phrase ici. Troisième phrase ici.' })
    const idAvant = c.beats[0].id
    const idsAutres = new Set(c.beats.slice(1).map((b) => b.id))
    c = splitBeat(c, 0)
    const [a, b] = c.beats
    expect(a.id).not.toBe(idAvant)
    expect(b.id).not.toBe(idAvant)
    expect(a.id).not.toBe(b.id)
    expect(idsAutres.has(a.id)).toBe(false)
    expect(idsAutres.has(b.id)).toBe(false)
  })
})
