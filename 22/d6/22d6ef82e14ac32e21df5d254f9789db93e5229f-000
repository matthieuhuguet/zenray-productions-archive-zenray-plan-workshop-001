describe('L11 — le Critique', () => {
  it('calcule un contraste juste, transparence comprise', () => {
    expect(contrastRatio('#000000', '#ffffff')).toBe(21)
    expect(contrastRatio('#ffffff', '#ffffff')).toBe(1)
    expect(parseColor('rgba(20,22,26,.56)')).toMatchObject({ r: 20, g: 22, b: 26 })
    // Un gris semi-transparent sur blanc doit être mesuré composé, donc bien plus clair que du noir plein.
    expect(contrastRatio('rgba(20,22,26,.56)', '#ffffff')).toBeLessThan(contrastRatio('#141a1a', '#ffffff'))
  })

  it('valide le projet de démonstration sans défaut bloquant', () => {
    const { brief, cut } = fixture()
    const issues = inspectStatic({ brief, cut, theme, format: webFormat, dark: false })
    const { blocking, canPublish } = summarize(issues)
    expect(blocking.map((b) => b.message)).toEqual([])
    expect(canPublish).toBe(true)
  })

  it('bloque un contraste sous le seuil du thème', () => {
    const { brief, cut } = fixture()
    const pale = { ...theme, palette: { ...theme.palette, ink: 'rgba(200,200,200,1)' } }
    const issues = inspectStatic({ brief, cut, theme: pale, format: webFormat })
    expect(issues.some((i) => i.code === 'contrast.low' && i.severity === SEVERITY.blocking)).toBe(true)
  })

  it('bloque une mention obligatoire absente', () => {
    const { brief, cut } = fixture()
    const withMention = { ...brief, constraints: { ...brief.constraints, mentions: ['Mention légale absente'] } }
    const issues = inspectStatic({ brief: withMention, cut, theme, format: webFormat })
    expect(issues.some((i) => i.code === 'mention.missing')).toBe(true)
  })

  it('avertit quand une intention de vente n’a pas d’appel', () => {
    const { brief, cut } = fixture()
    const sell = { ...brief, intent: 'vendre' }
    const noCta = { ...cut, beats: cut.beats.map((b) => ({ ...b, role: b.role === 'cta' ? 'payoff' : b.role })) }
    expect(inspectStatic({ brief: sell, cut: noCta, theme, format: webFormat }).some((i) => i.code === 'cut.noCta')).toBe(true)
  })
})

