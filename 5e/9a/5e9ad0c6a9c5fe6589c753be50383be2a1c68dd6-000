const merge = (a, b) => (b && typeof b === 'object' && !Array.isArray(b) ? Object.fromEntries(Object.keys({ ...a, ...b }).map((k) => [k, k in b ? (a && typeof a[k] === 'object' && !Array.isArray(a[k]) ? merge(a[k], b[k]) : b[k]) : a[k]])) : (b ?? a))
