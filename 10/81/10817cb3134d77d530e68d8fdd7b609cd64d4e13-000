:root[data-theme="dark"] { --bg: #1b1b1d; --fg: #f2f2f4; --muted: #a1a1a6; --cell: #252528; --glass-a: rgba(58,58,62,.82); --glass-b: rgba(40,40,44,.64); --line: rgba(255,255,255,.08); --shadow: 0 30px 80px rgba(0,0,0,.6); }
* { box-sizing: border-box; }
