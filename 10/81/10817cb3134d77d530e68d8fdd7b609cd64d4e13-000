.panel .row { display: flex; gap: 6px; margin-top: 6px; }
.panel .row button { flex: 1; padding: 6px; border-radius: 9px; border: 0; background: var(--line); }
.panel.min > :not(.toggle) { display: none; }
.panel .toggle { width: 100%; border: 0; background: none; text-align: left; padding: 0 0 8px; color: var(--muted); }
@media (max-width: 640px) { :root { --stage-h: 520px; } .chip { display: none; } }
