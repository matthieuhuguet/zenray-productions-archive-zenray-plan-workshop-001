  background: linear-gradient(135deg, var(--glass-a), var(--glass-b)); backdrop-filter: blur(24px) saturate(1.4); -webkit-backdrop-filter: blur(24px) saturate(1.4); box-shadow: 0 0 0 1px var(--line), var(--shadow); }
