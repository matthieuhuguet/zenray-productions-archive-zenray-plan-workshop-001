.ringhead p { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
.ringhead .navs { margin-left: auto; display: flex; gap: 6px; }
/* Workshop panel, never shipped / panneau d'atelier, jamais en production */
.panel { position: fixed; right: 16px; bottom: 16px; z-index: 10; width: min(310px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; padding: 12px; border-radius: 14px; background: var(--glass-a); box-shadow: 0 0 0 1px var(--line), 0 10px 30px rgba(0,0,0,.18); font-size: 13px; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.panel label { display: grid; grid-template-columns: 1fr 64px; gap: 2px 8px; margin-bottom: 6px; }
