@font-face { font-family: 'GTSectraLCG'; src: url('../_shared/fonts/GT-Sectra-LCGV-Regular.woff2') format('woff2'), url('file:///Users/zenray/Library/Fonts/GT-Sectra-LCGV-Regular.otf'); font-weight: 400; }
