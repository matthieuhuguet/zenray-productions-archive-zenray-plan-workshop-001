  events[0].summary = 'Sport du soir'; events[0].start = { dateTime: '2026-10-21T19:00:00+02:00' }; events[0].end = { dateTime: '2026-10-21T20:15:00+02:00' }
  const r2 = run(r1.board, events)
  assert.equal(r2.calOps.length, 0); assert.equal(r2.report.pulled, 1)
  assert.deepEqual([r2.board.tasks[0].title, r2.board.tasks[0].date, r2.board.tasks[0].startTime, r2.board.tasks[0].durationMin], ['Sport du soir', '2026-10-21', '19:00', 75])
})

test('both sides changed -> Plan wins and the conflict is reported', () => {
