test('done and publish marks are pushed on plan-origin events but never added to imported events', () => {
  const b = board(task({ status: 'done', publish: true }))
  const r1 = run(b, []); assert.equal(r1.calOps[0].body.summary, '✓ ✦ Sport')
  const imp = run(board(), [timedEvent()]); const importedBoard = imp.board; importedBoard.tasks[0].status = 'done'
  const r2 = run(importedBoard, [timedEvent()]); assert.equal(r2.calOps.length, 0)
  const r3 = run(board(task()), []); const evs = applyToEvents([], r3.calOps)
  const b3 = structuredClone(r3.board); b3.tasks[0].status = 'done'
  const r4 = run(b3, evs); assert.equal(r4.calOps.length, 1); assert.equal(r4.calOps[0].body.summary, '✓ Sport'); assert.equal(r4.calOps[0].reason, 'title')
})

test('foreign events: imported from importFrom onward only; own-marker events never imported; skipped types ignored', () => {
  const events = [
    timedEvent({ id: 'old', start: { dateTime: '2026-07-10T10:00:00+02:00' }, end: { dateTime: '2026-07-10T11:00:00+02:00' } }),
    timedEvent({ id: 'new', start: { dateTime: '2026-07-11T10:00:00+02:00' }, end: { dateTime: '2026-07-11T11:30:00+02:00' } }),
    timedEvent({ id: 'bday', eventType: 'birthday', start: { dateTime: '2026-08-01T10:00:00+02:00' }, end: { dateTime: '2026-08-01T11:00:00+02:00' } }),
    { id: 'allday', status: 'confirmed', summary: 'Stay at X', start: { date: '2026-10-30' }, end: { date: '2026-11-02' }, organizer: { self: true } },
  ]
  const r = run(board(), events)
  assert.equal(r.report.imported, 2); assert.equal(r.report.outsideWindow, 1); assert.equal(r.report.skippedTypes, 1)
  const [timed, allDay] = r.board.tasks
  assert.deepEqual([timed.title, timed.date, timed.startTime, timed.durationMin, timed.status, timed.source], ['RDV', '2026-07-11', '10:00', 90, 'done', 'gcal'])
  assert.deepEqual([allDay.date, allDay.startTime, allDay.status], ['2026-10-30', null, 'planned'])
  assert.equal(r.calOps.length, 0, 'importing never writes to Google')
  assert.equal(run(r.board, events).report.imported, 0, 'second run imports nothing')
})

