test('task removed from the Plan -> its event is deleted, imported ones too; cap protects against mass deletion', () => {
  const r1 = run(board(task(), task({ id: 't2', title: 'B' })), []); let events = applyToEvents([], r1.calOps)
  const b = structuredClone(r1.board); b.tasks = b.tasks.filter((t) => t.id !== 't2')
  const r2 = run(b, events); assert.deepEqual(r2.calOps.map((o) => o.op), ['delete']); assert.equal(r2.calOps[0].eventId, eventIdFor('t2'))
  const imp = run(board(), [timedEvent()]); const empty = structuredClone(imp.board); empty.tasks = []
  const r3 = run(empty, [timedEvent()]); assert.deepEqual(r3.calOps.map((o) => o.op), ['delete'])
  const many = Array.from({ length: 12 }, (_, i) => task({ id: `m${i}`, date: `2026-10-${20 + (i % 9)}` })); const rr = run(board(...many), []); const evs = applyToEvents([], rr.calOps)
  const cleared = structuredClone(rr.board); cleared.tasks = []
  assert.throws(() => run(cleared, evs), /refusing 12 deletions/)
  assert.doesNotThrow(() => run(cleared, evs, { maxDeletesPerRun: 20 }))
})

test('event deleted in the calendar -> task dropped, never recreated; dropped in the Plan -> event deleted, stays gone, revives when undropped', () => {
  const r1 = run(board(task()), []); let events = applyToEvents([], r1.calOps)
  const r2 = run(r1.board, []) // the calendar lost it / l'agenda l'a perdu
  assert.equal(r2.board.tasks[0].status, 'dropped'); assert.equal(r2.calOps.length, 0); assert.equal(r2.report.droppedFromCalendar, 1)
  assert.equal(run(r2.board, []).calOps.length, 0)
  const b = structuredClone(r1.board); b.tasks[0].status = 'dropped'
  const d1 = run(b, events); assert.deepEqual(d1.calOps.map((o) => o.op), ['delete'])
  events = applyToEvents(events, d1.calOps); const d2 = run(d1.board, events); assert.equal(d2.calOps.length, 0)
  const back = structuredClone(d2.board); back.tasks[0].status = 'planned'
  const d3 = run(back, events); assert.deepEqual(d3.calOps.map((o) => o.op), ['revive'])
})

