test('inPlace mode mutates the given board and gives the same result as the cloning mode', () => {
  const b = board(task(), task({ id: 't2', title: 'B', date: '2026-10-21' })); const ev = [timedEvent()]
  const cloned = run(b, ev); const mutable = structuredClone(b)
  const inPlace = reconcile(mutable, ev, { ...P }, { now: NOW, uid: (() => { let k = 0; return () => `imp${++k}` })() }, { inPlace: true })
  assert.equal(inPlace.board, mutable); assert.deepEqual(inPlace.calOps.map((o) => o.op), cloned.calOps.map((o) => o.op)); assert.equal(inPlace.board.tasks.length, cloned.board.tasks.length)
})

test('Europe/Paris computed by rule equals Intl on 20000 random instants (2020-2030) and on every DST boundary minute', () => {
  const intl = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
  const viaIntl = (ms) => { const p = Object.fromEntries(intl.formatToParts(new Date(ms)).filter((x) => x.type !== 'literal').map((x) => [x.type, x.value])); return { date: `${p.year}-${p.month}-${p.day}`, time: `${p.hour}:${p.minute}` } }
  let seed = 12345; const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296
  const lo = Date.UTC(2020, 0, 1), hi = Date.UTC(2030, 0, 1)
  for (let i = 0; i < 20000; i++) { const ms = Math.floor(lo + rnd() * (hi - lo)); assert.deepEqual(localParts(new Date(ms).toISOString(), 'Europe/Paris'), viaIntl(ms)) }
  for (let year = 2020; year <= 2030; year++) for (const month of [2, 9]) {
    const d = new Date(Date.UTC(year, month + 1, 0)); const boundary = Date.UTC(year, month, d.getUTCDate() - d.getUTCDay(), 1)
    for (let m = -125; m <= 125; m++) { const ms = boundary + m * 60000; assert.deepEqual(localParts(new Date(ms).toISOString(), 'Europe/Paris'), viaIntl(ms)) }
  }
  assert.equal(parisOffsetMinutes(Date.UTC(2026, 6, 1)), 120); assert.equal(parisOffsetMinutes(Date.UTC(2026, 0, 1)), 60)
})

test('events given with a foreign offset (New York) are read as Paris wall time', () => {
  assert.deepEqual(localParts('2024-11-15T17:00:00-05:00', 'Europe/Paris'), { date: '2024-11-15', time: '23:00' })
  assert.deepEqual(localParts('2026-07-11T22:00:00-04:00', 'Europe/Paris'), { date: '2026-07-12', time: '04:00' })
})

test('performance guard: any other time zone builds ONE Intl.DateTimeFormat however many events are read, and Paris builds none', () => {
  const Original = Intl.DateTimeFormat; let built = 0
  Intl.DateTimeFormat = class extends Original { constructor(...args) { super(...args); built++ } }
  try {
    for (let i = 0; i < 300; i++) localParts('2026-10-20T10:00:00Z', 'Pacific/Auckland')
    assert.equal(built, 1)
    for (let i = 0; i < 300; i++) localParts('2026-10-20T10:00:00Z', 'Europe/Paris')
    assert.equal(built, 1)
  } finally { Intl.DateTimeFormat = Original }
})

// Attachment edits update Calendar without changing the task time. (19 October 2026, 00:32 Paris)
test('attachment links are inserted, updated, removed and stable on the next sync', () => {
  const attachment = { name: 'audio.m4a', url: 'https://zenray-progress.pages.dev/api/attachment-download?share=opaque' }
  const first = run(board(task({ note: 'Listen', attachments: [attachment] })), [])
  const body = first.calOps[0].body
  expect(body.description).toContain(attachment.url)
  expect(body.description).toContain('Listen')
  const event = applyToEvents([], first.calOps)[0]
  expect(run(first.board, [event]).calOps).toHaveLength(0)
  first.board.tasks[0].attachments = []
  const removed = run(first.board, [event])
  expect(removed.calOps[0].body.description).toBe('Listen')
})

test('attachments on imported events preserve their full Google description', () => {
  const event = timedEvent({ description: 'Original Google note '.repeat(80) })
  const imported = run(board(), [event])
  imported.board.tasks[0].attachments = [{ name: 'file', url: 'https://site.test/download' }]
  const added = run(imported.board, [event])
  expect(added.calOps[0].body.description).toContain(event.description)
  const updated = { ...event, ...added.calOps[0].body }
  expect(run(added.board, [updated]).calOps).toHaveLength(0)
  added.board.tasks[0].attachments = []
  expect(run(added.board, [updated]).calOps[0].body.description).toBe(event.description)
})
