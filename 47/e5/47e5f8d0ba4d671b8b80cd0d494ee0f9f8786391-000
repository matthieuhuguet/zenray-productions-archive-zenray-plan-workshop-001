// core.test.js (17 October 2026): rules of the Plan <-> Google Calendar reconciliation, both directions on purpose (every rule has a case that must act
// AND a case that must do nothing). Ported from the Mac version's node:test file. FR : chaque regle a un cas qui agit ET un cas qui ne fait rien.
import { test, expect } from 'vitest'
import { reconcile, parisOffsetMinutes, eventIdFor, hashCanon, hashMatches, legacyHashCanon, canonOfEvent, localParts, stripMarks } from '../src/core.js'
import { loadParams } from '../src/params.js'

const assert = {
  equal: (a, b) => expect(a).toBe(b), deepEqual: (a, b) => expect(a).toEqual(b), match: (a, r) => expect(a).toMatch(r),
  throws: (f, r) => expect(f).toThrow(r), doesNotThrow: (f) => expect(f).not.toThrow(),
}
const P = loadParams({})
const NOW = new Date('2026-10-17T12:00:00Z')
let n = 0
const ctx = () => ({ now: NOW, uid: () => `imp${++n}` })
const task = (o = {}) => ({ id: 't1', title: 'Sport', date: '2026-10-20', startTime: '17:00', durationMin: 60, status: 'planned', note: '', ...o })
const board = (...tasks) => ({ type: 'plan', v: 1, title: 'P', tasks })
const timedEvent = (o = {}) => ({ id: 'evx', status: 'confirmed', summary: 'RDV', start: { dateTime: '2026-10-20T10:00:00+02:00' }, end: { dateTime: '2026-10-20T11:00:00+02:00' }, organizer: { self: true }, ...o })
const run = (b, events, over = {}) => reconcile(b, events, { ...P, ...over }, ctx())
const settle = (b, events) => { const r = run(b, events); return r } // first run: creates links / premier passage

// Helper: simulate the calendar after applying ops, to prove idempotence / simule l'agenda apres les operations.
function applyToEvents(events, calOps, tasks, params = P) {
  const out = events.filter((e) => !calOps.some((o) => o.op === 'delete' && o.eventId === e.id))
  for (const o of calOps) {
    if (o.op === 'insert' || o.op === 'revive') out.push({ id: o.eventId, status: 'confirmed', organizer: { self: true }, iCalUID: `${o.eventId}@google.com`, ...structuredClone(o.body),
      start: o.body.start.dateTime ? { dateTime: `${o.body.start.dateTime}+02:00` } : o.body.start, end: o.body.end.dateTime ? { dateTime: `${o.body.end.dateTime}+02:00` } : o.body.end })
    if (o.op === 'patch') { const e = out.find((x) => x.id === o.eventId); Object.assign(e, structuredClone(o.body), { start: o.body.start.dateTime ? { dateTime: `${o.body.start.dateTime}+02:00` } : o.body.start, end: o.body.end.dateTime ? { dateTime: `${o.body.end.dateTime}+02:00` } : o.body.end }) }
  }
  return out
}

test('new Plan task -> one insert with a stable valid id, then no further operation (idempotent)', () => {
  const r1 = run(board(task()), [])
  assert.equal(r1.calOps.length, 1); assert.equal(r1.calOps[0].op, 'insert')
  assert.match(r1.calOps[0].eventId, /^[a-v0-9]{5,}$/); assert.equal(r1.calOps[0].eventId, eventIdFor('t1'))
  assert.deepEqual(r1.calOps[0].body.start, { dateTime: '2026-10-20T17:00:00', timeZone: 'Europe/Paris' })
  assert.deepEqual(r1.calOps[0].body.end, { dateTime: '2026-10-20T18:00:00', timeZone: 'Europe/Paris' })
  const events = applyToEvents([], r1.calOps)
  const r2 = run(r1.board, events)
  assert.equal(r2.calOps.length, 0); assert.equal(r2.report.imported, 0)
})

test('Plan title change -> exactly one patch; Plan time change -> patch with new times', () => {
  const r1 = run(board(task()), []); const events = applyToEvents([], r1.calOps)
  const b = structuredClone(r1.board); b.tasks[0].title = 'Sport lourd'; b.tasks[0].startTime = '18:30'
  const r2 = run(b, events)
  assert.equal(r2.calOps.length, 1); assert.equal(r2.calOps[0].op, 'patch')
  assert.equal(r2.calOps[0].body.summary, 'Sport lourd'); assert.equal(r2.calOps[0].body.start.dateTime, '2026-10-20T18:30:00')
})

test('Calendar time and title change -> task updated, nothing sent to Google', () => {
