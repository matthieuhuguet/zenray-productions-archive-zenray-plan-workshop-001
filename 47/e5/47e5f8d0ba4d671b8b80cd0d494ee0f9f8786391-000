test('legacy sha1 hashes from the Mac version are understood and migrated to the cheap hash without any operation', () => {
  const r1 = run(board(task()), []); const events = applyToEvents([], r1.calOps)
  const legacy = structuredClone(r1.board); const canon = ['Sport', '2026-10-20', '17:00', 60]
  legacy.tasks[0].gcal.hash = legacyHashCanon(canon)
  assert.equal(hashMatches(legacy.tasks[0].gcal.hash, canon), true); assert.equal(hashMatches(legacy.tasks[0].gcal.hash, ['Autre', ...canon.slice(1)]), false)
  const r2 = run(legacy, events)
  assert.equal(r2.calOps.length, 0); assert.equal(r2.report.pulled, 0); assert.equal(r2.report.conflicts.length, 0)
  expect(r2.board.tasks[0].gcal.hash).toMatch(/^h[0-9a-f]{14}$/)
})

test('legacy hash plus a real Plan change is still seen as a Plan change (no silent loss during migration)', () => {
  const r1 = run(board(task()), []); const events = applyToEvents([], r1.calOps)
  const legacy = structuredClone(r1.board); legacy.tasks[0].gcal.hash = legacyHashCanon(['Sport', '2026-10-20', '17:00', 60]); legacy.tasks[0].startTime = '19:00'
  const r2 = run(legacy, events); assert.equal(r2.calOps.length, 1); assert.equal(r2.calOps[0].body.start.dateTime, '2026-10-20T19:00:00')
})

test('the cheap hash separates different contents and is stable', () => {
  assert.equal(hashCanon(['a', 'b', null, null]), hashCanon(['a', 'b', null, null]))
  expect(hashCanon(['a', 'b', null, null])).not.toBe(hashCanon(['a', 'b', '10:00', null]))
  expect(hashCanon(['Sport', '2026-10-20', '17:00', 60])).not.toBe(hashCanon(['Sport', '2026-10-20', '17:00', 61]))
})

